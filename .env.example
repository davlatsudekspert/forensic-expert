# FORENSIC EXPERT — muhit o'zgaruvchilari namunasi.
# Bu faylda FAQAT placeholder bo'ladi. Haqiqiy qiymatlar .env faylida (git ignore)
# yoki CI secret store'da saqlanadi. Ilova ichiga hech qanday maxfiy kalit joylanmaydi.

# Backend (PHASE 3+). Faqat ommaviy (anon/publishable) kalit ilovaga tushishi mumkin.
FE_BACKEND_URL=https://example.invalid
FE_BACKEND_PUBLISHABLE_KEY=REPLACE_ME_PUBLISHABLE_KEY_ONLY

# Billing (PHASE 9). RevenueCat'ning ommaviy SDK kalitlari.
FE_REVENUECAT_APPLE_PUBLIC_KEY=REPLACE_ME
FE_REVENUECAT_GOOGLE_PUBLIC_KEY=REPLACE_ME

# Kontent paketini imzolash (faqat CI/offline imzolash muhitida, ilovada EMAS).
# Maxfiy kalit fayl yo'li repozitoriydan TASHQARIDA bo'lishi shart.
FE_CONTENT_SIGNING_KEY_PATH=/secure/path/outside/repo/content-signing.key
FE_CONTENT_SIGNING_KEY_ID=fe-content-REPLACE_ME

# Server-side (Edge Functions) — hech qachon mobil ilovaga berilmaydi.
# FE_SERVICE_ROLE_KEY=  (faqat server secret store'da)
# FE_AI_PROVIDER_API_KEY= (faqat server secret store'da)
