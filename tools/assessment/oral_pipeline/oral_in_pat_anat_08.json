[
{
"id": "pat_anat.c23.085",
"text": "O‘pka yuragi nima, rivojlanish mexanizmi, morfologiyasi."
},
{
"id": "pat_anat.c23.086",
"text": "O‘pka raki, joylanishi bo‘yicha turlari."
},
{
"id": "pat_anat.c23.087",
"text": "Surinkali gastrit, etiologiya va patogenezi."
},
{
"id": "pat_anat.c23.088",
"text": "Surinkali gastrit turlari, makro- va mikro- o‘zgarishlari."
},
{
"id": "pat_anat.c23.089",
"text": "Me’da yara kasalligi ta’rifi, etiologiya va patogenezi."
},
{
"id": "pat_anat.c23.090",
"text": "Yara kasalligining davrlari, 1-davrining morfologiyasi."
},
{
"id": "pat_anat.c23.091",
"text": "Yara kasalligining davrlari, 2-davrining morfologiyasi."
},
{
"id": "pat_anat.c23.092",
"text": "Yara kasalligining davrlari, 3-davrining morfologiyasi."
},
{
"id": "pat_anat.c23.093",
"text": "Yara kasalligi asoratlari va o‘lim sabablari."
},
{
"id": "pat_anat.c23.094",
"text": "Me’da raki, predrak holatlari."
},
{
"id": "pat_anat.c23.095",
"text": "Me’da raki, joylanishi bo‘yicha turlari."
},
{
"id": "pat_anat.c23.096",
"text": "Me’da raki, gistologik turlari."
}
]