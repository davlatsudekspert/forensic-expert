[
{
"id": "sud_tib.c0.034",
"text": "Bevosita va bilvosita qontalashlarning differensial diagnostikasi."
},
{
"id": "sud_tib.c0.035",
"text": "Suyaklar deformatsiyasi turlari."
},
{
"id": "sud_tib.c0.037",
"text": "Balandlikdan yiqilish."
},
{
"id": "sud_tib.c0.038",
"text": "Yuzaga yiqilish."
},
{
"id": "sud_tib.c0.039",
"text": "Zaharlanish holatlarida laboratoriya tekshiruvlari va ularning natijalarini baholash."
},
{
"id": "sud_tib.c0.040",
"text": "Vidmark-Balyakin formulasini tushuntirib bering."
},
{
"id": "sud_tib.c0.041",
"text": "Etil spirti surrogatlari bilan zaharlanish."
},
{
"id": "sud_tib.c0.042",
"text": "“Narkotiklar bilan bog‘liq o‘lim” tushunchasi."
},
{
"id": "sud_tib.c0.043",
"text": "Elektrotravmada o‘lim sabablari."
},
{
"id": "sud_tib.c0.044",
"text": "Elektr tokining nospesifik ta’siri."
},
{
"id": "sud_tib.c0.045",
"text": "Elektrotravmada laboratoriya tekshiruvlarining ahamiyati."
},
{
"id": "sud_tib.c0.046",
"text": "Elektr-tamg‘aning makro- va mikroskopik ko‘rinishi."
}
]