[
{
"id": "sud_tib.c23.092",
"text": "Mexanik asfiksiyaning ichki umumiy belgilari."
},
{
"id": "sud_tib.c23.093",
"text": "Autoasfiksiofiliya."
},
{
"id": "sud_tib.c23.094",
"text": "Osilish."
},
{
"id": "sud_tib.c23.095",
"text": "Sirtmoq bilan bo‘g‘ish."
},
{
"id": "sud_tib.c23.096",
"text": "Strangulyatsion egatning hayotiyligini aniqlash."
},
{
"id": "sud_tib.c23.097",
"text": "Qo‘l bilan bo‘g‘ish."
},
{
"id": "sud_tib.c23.098",
"text": "Kompression asfiksiya."
},
{
"id": "sud_tib.c23.099",
"text": "Nafas teshiklarining yopilishi."
},
{
"id": "sud_tib.c23.100",
"text": "Nafas yo‘llarining yopilishi."
},
{
"id": "sud_tib.c23.101",
"text": "Cheklangan muhitda asfiksiya."
},
{
"id": "sud_tib.c23.102",
"text": "Ho‘l tipdagi cho‘kishning belgilari."
},
{
"id": "sud_tib.c23.103",
"text": "Quruq tipdagi cho‘kishning belgilari."
}
