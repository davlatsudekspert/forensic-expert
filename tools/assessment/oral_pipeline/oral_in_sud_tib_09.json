[
{
"id": "sud_tib.c23.104",
"text": "Cho‘kishning diagnostikasida laboratoriya tekshiruvlarining ahamiyati."
},
{
"id": "sud_tib.c23.105",
"text": "Tan jarohati tushunchasi. Shikastlovchi omillar."
},
{
"id": "sud_tib.c23.107",
"text": "Mexanik jarohatlar."
},
{
"id": "sud_tib.c23.108",
"text": "Mexanik jarohatlardan o‘lim sabablari."
},
{
"id": "sud_tib.c23.109",
"text": "O‘tmas jismlarning tasnifi."
},
{
"id": "sud_tib.c23.110",
"text": "O‘tmas jismlardan shikastlanish mexanizmi."
},
{
"id": "sud_tib.c23.111",
"text": "Shilinmalar, rivojlanish bosqichlari, sud-tibbiy ahamiyati."
},
{
"id": "sud_tib.c23.112",
"text": "Shilinmalarning pergament dog‘laridan farqlari."
},
{
"id": "sud_tib.c23.113",
"text": "Qontalashlar, sud-tibbiy ahamiyati."
},
{
"id": "sud_tib.c23.114",
"text": "Qontalashlar va murda dog‘larining differensial diagnostikasi."
},
{
"id": "sud_tib.c23.115",
"text": "O‘tmas jismlardan yetkazilgan yaralar."
},
{
"id": "sud_tib.c23.116",
"text": "Balandlikdan yiqilishda vujudga keladigan jarohatlarning xususiyatlari."
}
]