[
{
"id": "pat_anat.c23.061",
"text": "Yurak ishemik kasalligi asoratlari va o‘lim sabablari."
},
{
"id": "pat_anat.c23.062",
"text": "Kardiomiopatiyaga ta’rif bering, turlari."
},
{
"id": "pat_anat.c23.063",
"text": "Revmatizmga ta’rif bering, etiologiyasi."
},
{
"id": "pat_anat.c23.064",
"text": "Revmatizmga ta’rif bering, patogenezi."
},
{
"id": "pat_anat.c23.065",
"text": "Revmatizmning morfologik davrlari, 1- va 2-davrining morfologiyasi."
},
{
"id": "pat_anat.c23.066",
"text": "Revmatizmning morfologik davrlari, 3-davrning morfologiyasi."
},
{
"id": "pat_anat.c23.067",
"text": "Revmatizm tugunchasining formalari, tuzilishi."
},
{
"id": "pat_anat.c23.068",
"text": "Revmatik endokarditning formalari, 1-formasi morfologiyasi."
},
{
"id": "pat_anat.c23.069",
"text": "Revmatik endokarditning formalari, 2-formasi morfologiyasi."
},
{
"id": "pat_anat.c23.070",
"text": "Revmatik endokarditning formalari, 3-formasi morfologiyasi."
},
{
"id": "pat_anat.c23.071",
"text": "Revmatik endokarditning formalari, 4-formasi morfologiyasi."
},
{
"id": "pat_anat.c23.072",
"text": "Revmatizm asoratlari va o‘lim sabablari."
}
]