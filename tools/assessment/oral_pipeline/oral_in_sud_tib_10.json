[
{
"id": "sud_tib.c23.117",
"text": "Sanchuvchi jismlardan yetkazilgan jarohatlar."
},
{
"id": "sud_tib.c23.118",
"text": "Kesuvchi jismlardan yetkazilgan jarohatlar."
},
{
"id": "sud_tib.c23.119",
"text": "Sanchuvchi-kesuvchi jismlardan yetkazilgan jarohatlar."
},
{
"id": "sud_tib.c23.120",
"text": "Chopuvchi jismlardan yetkazilgan jarohatlar."
},
{
"id": "sud_tib.c23.122",
"text": "Avtotravmada yetkaziladigan jarohatlarning turlari."
},
{
"id": "sud_tib.c23.123",
"text": "Avtotravmada spetsifik jarohatlar."
},
{
"id": "sud_tib.c23.124",
"text": "Avtotravmada xos jarohatlar."
},
{
"id": "sud_tib.c23.125",
"text": "Bamper-jarohatlar, ularning sud-tibbiy ahamiyati."
},
{
"id": "sud_tib.c23.126",
"text": "Harakatdagi avtomobil qismlaridan zarb."
},
{
"id": "sud_tib.c23.127",
"text": "Avtomobil g‘ildiraklari bilan bosib o‘tish."
},
{
"id": "sud_tib.c23.128",
"text": "Avtomobil salonida travma."
},
{
"id": "sud_tib.c23.129",
"text": "Harakatdagi avtomobildan yiqilish."
}
]