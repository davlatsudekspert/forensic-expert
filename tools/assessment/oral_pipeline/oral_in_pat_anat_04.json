[
{
"id": "pat_anat.c23.037",
"text": "Aterosklerozning xavfli omillari."
},
{
"id": "pat_anat.c23.038",
"text": "Arteriosklerozning turlarini sanab bering."
},
{
"id": "pat_anat.c23.039",
"text": "Aterosklerozning makroskopik davrlari."
},
{
"id": "pat_anat.c23.040",
"text": "Aterosklerozning mikroskopik davrlari."
},
{
"id": "pat_anat.c23.041",
"text": "Aorta aterosklerozining o‘ziga xosligi va asoratlari."
},
{
"id": "pat_anat.c23.042",
"text": "Yurak toj arteriyalari aterosklerozining klinik –morfologik formalari."
},
{
"id": "pat_anat.c23.043",
"text": "Buyrak arteriyasi aterosklerozi morfologiyasi."
},
{
"id": "pat_anat.c23.044",
"text": "Bosh miya arteriyalari aterosklerozi klinik-morfologik ko‘rinishi."
},
{
"id": "pat_anat.c23.045",
"text": "Oyoq arteriyalari aterosklerozi klinik-morfologik ko‘rinishi."
},
{
"id": "pat_anat.c23.046",
"text": "Gipertoniya kasalligiga ta’rif bering, qaysi a’zo kasallanadi."
},
{
"id": "pat_anat.c23.047",
"text": "Simptomatik gipertoniyalarni sanab bering, sabablari."
},
{
"id": "pat_anat.c23.048",
"text": "Gipertoniya kasalligi patogenezi va xavfli omillari."
}
]