[
{
"id": "pat_anat.c23.073",
"text": "Krupoz pnevmoniyaga ta’rif bering, nomlanishlari va qo‘zg‘atuvchisi."
},
{
"id": "pat_anat.c23.074",
"text": "Krupoz pnevmoniya davrlari, 1-davri morfologiyasi."
},
{
"id": "pat_anat.c23.075",
"text": "Krupoz pnevmoniya davrlari, 2-davri morfologiyasi."
},
{
"id": "pat_anat.c23.076",
"text": "Krupoz pnevmoniya davrlari, 3-davri morfologiyasi."
},
{
"id": "pat_anat.c23.077",
"text": "Krupoz pnevmoniya asoratlari va o‘lim sabablari."
},
{
"id": "pat_anat.c23.078",
"text": "Bronxopnevmoniyaga ta’rif bering, sabablari."
},
{
"id": "pat_anat.c23.079",
"text": "Bronxopnevmoniyaning makro- va mikroskopik o‘zgarishlari."
},
{
"id": "pat_anat.c23.080",
"text": "Bronxopnevmoniya asoratlari va o‘lim sabablari."
},
{
"id": "pat_anat.c23.081",
"text": "Surinkali bronxit, makro- va mikro- o‘zgarishlari."
},
{
"id": "pat_anat.c23.082",
"text": "Bronxoektaziya nima, turlari, makro- va mikro- o‘zgarishlari."
},
{
"id": "pat_anat.c23.083",
"text": "Pnevmoskleroz, pnevmosirroz nima, morfologiyasi."
},
{
"id": "pat_anat.c23.084",
"text": "O‘pka emfizemasi, turlari, makro- va mikro- o‘zgarishlari."
}
