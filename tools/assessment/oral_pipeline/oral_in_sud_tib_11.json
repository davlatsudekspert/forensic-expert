[
{
"id": "sud_tib.c23.130",
"text": "Avtotravmada kiyim, poyafzalni tekshirishning ahamiyati."
},
{
"id": "sud_tib.c23.131",
"text": "O‘q otar qurollar, tasnifi."
},
{
"id": "sud_tib.c23.132",
"text": "O‘q otishda shikastlovchi omillar."
},
{
"id": "sud_tib.c23.133",
"text": "O‘q otishda shikastlanishning turlari."
},
{
"id": "sud_tib.c23.134",
"text": "Tirab otishda yetkazilgan jarohatlarning xususiyatlari."
},
{
"id": "sud_tib.c23.135",
"text": "Yaqin distansiyadan otishda yetkazilgan jarohatlarning xususiyatlari."
},
{
"id": "sud_tib.c23.137",
"text": "Kinetik energiyasi bo‘yicha o‘qning ta’sir turlari."
},
{
"id": "sud_tib.c23.138",
"text": "O‘q otar kirish teshigining xususiyatlari."
},
{
"id": "sud_tib.c23.139",
"text": "O‘q otar chiqish teshigining xususiyatlari."
},
{
"id": "sud_tib.c23.140",
"text": "O‘q otar jarohatlarda yara kanali."
},
{
"id": "sud_tib.c23.141",
"text": "Gaz qurolidan shikastlanish."
},
{
"id": "sud_tib.c23.142",
"text": "Bo‘sh patron otishda shikastlanish."
}
]