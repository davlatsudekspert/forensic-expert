[
{
"id": "sud_tib.c23.079",
"text": "Bolalarning nogahon o‘limi."
},
{
"id": "sud_tib.c23.080",
"text": "Go‘daklarning to‘satdan o‘limi sindromi."
},
{
"id": "sud_tib.c23.081",
"text": "Yangi tug‘ilganlikni aniqlash."
},
{
"id": "sud_tib.c23.082",
"text": "Tirik tug‘ilganlikni aniqlash."
},
{
"id": "sud_tib.c23.083",
"text": "Gestatsion yoshni aniqlash."
},
{
"id": "sud_tib.c23.084",
"text": "Homilaning hayotga layoqatliligini aniqlash."
},
{
"id": "sud_tib.c23.085",
"text": "Homilaning tug‘ilgandan so‘ng qancha yashaganligini aniqlash."
},
{
"id": "sud_tib.c23.086",
"text": "Yangi tug‘ilgan chaqalaoqlar murdasi sud-tibbiy ekspertizasining xususiyatlari."
},
{
"id": "sud_tib.c23.087",
"text": "Yangi tug‘ilgan chaqalaoqlarning o‘lim sabablari."
},
{
"id": "sud_tib.c23.088",
"text": "Mexanik asfiksiya, tasnifi."
},
{
"id": "sud_tib.c23.089",
"text": "Asfiksiyaning hayotiy kechuvi."
},
{
"id": "sud_tib.c23.090",
"text": "Postasfiktik holat."
}
]