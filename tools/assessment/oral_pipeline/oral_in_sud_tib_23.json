[
{
"id": "sud_tib.c0.010",
"text": "Sud ekspertining so‘rog‘i."
},
{
"id": "sud_tib.c0.011",
"text": "Tanatogenez va uning sud-tibbiy ahamiyati."
},
{
"id": "sud_tib.c0.012",
"text": "Supravital reaksiyalar va ularning sud-tibbiy ahamiyati."
},
{
"id": "sud_tib.c0.013",
"text": "Miya o‘limi tushunchasi va uning ahamiyati."
},
{
"id": "sud_tib.c0.014",
"text": "Mushak qotishining vujudga kelish mexanizmi."
},
{
"id": "sud_tib.c0.015",
"text": "Saponifikatsiyaning vujudga kelish mexanizmi."
},
{
"id": "sud_tib.c0.016",
"text": "Bo‘laklangan murdalarning sud-tibbiy ekspertizasining xususiyatlari."
},
{
"id": "sud_tib.c0.017",
"text": "Yangi tug‘ilganlik belgilarini qiyosiy baholash."
},
{
"id": "sud_tib.c0.018",
"text": "Gestatsion yoshni aniqlash usullari."
},
{
"id": "sud_tib.c0.019",
"text": "Yangi tug‘ilgan go‘daklarning o‘limi sabablari."
},
{
"id": "sud_tib.c0.020",
"text": "Go‘daklarda tirik tug‘ilganlik belgilari."
},
{
"id": "sud_tib.c0.021",
"text": "Postasfiktik holatning klinik belgilari."
}
]