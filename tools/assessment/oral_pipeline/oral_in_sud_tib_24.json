[
{
"id": "sud_tib.c0.022",
"text": "Postasfiktik holatda o‘lim sabablari."
},
{
"id": "sud_tib.c0.023",
"text": "Umumasfiktik belgilarni qiyosiy sud-tibbiy baholash."
},
{
"id": "sud_tib.c0.024",
"text": "Tipik va atipik osilish holatlarida farqli xususiyatlar."
},
{
"id": "sud_tib.c0.025",
"text": "Autoasfiksiofiliya holatlari sud-tibbiy ekspertiza."
},
{
"id": "sud_tib.c0.026",
"text": "Cho‘kish holatlarida laboratoriya tekshiruvlarining ahamiyati."
},
{
"id": "sud_tib.c0.027",
"text": "Mexanik jarohatlarning hayotiyligini aniqlash."
},
{
"id": "sud_tib.c0.028",
"text": "O‘tmas yuzali jismlarning tasnifi."
},
{
"id": "sud_tib.c0.029",
"text": "O‘tmas jismlarning ta’sir mexanizmi turlari."
},
{
"id": "sud_tib.c0.030",
"text": "Impression va inersion travma."
},
{
"id": "sud_tib.c0.031",
"text": "O‘tmas jismlardan yetkazilgan yaralarning xususiyatlari."
},
{
"id": "sud_tib.c0.032",
"text": "O‘q otar jarohatlar bo‘yicha N.I.Pirogovning ilmiy ishlari ahamiyati."
},
{
"id": "sud_tib.c0.033",
"text": "Portlash travmasida distansiyani aniqlash."
}
]