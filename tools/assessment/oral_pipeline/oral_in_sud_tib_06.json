"id": "sud_tib.c23.066",
"text": "Murda qotishi."
},
{
"id": "sud_tib.c23.067",
"text": "Murda dog‘lari."
},
{
"id": "sud_tib.c23.068",
"text": "Murdaning chirishi."
},
{
"id": "sud_tib.c23.069",
"text": "Mumifikatsiya."
},
{
"id": "sud_tib.c23.070",
"text": "Yog‘-mum (sovunlanish)."
},
{
"id": "sud_tib.c23.071",
"text": "Murdaning hasharotlar tomonidan yemirilishi."
},
{
"id": "sud_tib.c23.072",
"text": "Murdaning qismlanishi."
},
{
"id": "sud_tib.c23.073",
"text": "O‘lim sodir bo‘lgan muddatni aniqlash."
},
{
"id": "sud_tib.c23.074",
"text": "Supravital reaksiyalar."
},
{
"id": "sud_tib.c23.075",
"text": "Murdaning sud-tibbiy ekspertizasi."
},
{
"id": "sud_tib.c23.077",
"text": "Eksgumatsiya qilingan murdani tekshirishning xususiyatlari."
},
{
"id": "sud_tib.c23.078",
"text": "Katta yoshdagilarning nogahon o‘limining xususiyatlari."
}
