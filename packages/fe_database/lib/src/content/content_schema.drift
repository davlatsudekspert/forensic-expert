-- FORENSIC EXPERT content.db sxemasi (schema_version = 3: PHASE 4 global bilim tizimi).
-- Bu baza ilovada FAQAT O‘QISH uchun. U imzolangan kontent paketidan keladi.
-- Hujjat: docs/00_ARXITEKTURA_REJASI.md (6, 9, 22, 23-bo‘limlar).
--
-- Muhim qarorlar:
--  * CAS uchun alohida ustun YO‘Q. Barcha tashqi identifikatorlar
--    external_identifiers jadvalida; ularni ishlatish IdentifierPolicy’ga bog‘liq.
--  * Konsentratsiyalar uchun "fatal" toifasi YO‘Q (CHECK cheklovi).
--  * is_test_data — test ma’lumotni production’dan ajratish.

CREATE TABLE content_meta (
  meta_key TEXT NOT NULL PRIMARY KEY,
  meta_value TEXT NOT NULL
) WITHOUT ROWID;

CREATE TABLE sources (
  source_id TEXT NOT NULL PRIMARY KEY,
  source_type TEXT NOT NULL,
  title TEXT NOT NULL,
  authors_json TEXT NOT NULL DEFAULT '[]',
  organization TEXT,
  journal TEXT,
  publication_year INTEGER,
  edition TEXT,
  doi TEXT,
  pmid TEXT,
  official_url TEXT,
  accessed_date TEXT,
  tier INTEGER NOT NULL CHECK (tier IN (1, 2, 3)),
  evidence_level TEXT NOT NULL CHECK (evidence_level IN ('A','B','C','D','E')),
  license_mode TEXT NOT NULL,
  license_agreement_id TEXT,
  identifier_verified INTEGER NOT NULL DEFAULT 0,
  review_status TEXT NOT NULL,
  last_reviewed_at TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  is_test_data INTEGER NOT NULL DEFAULT 0
) WITHOUT ROWID;

-- ---------------------------------------------------------------------------
-- Jurisdiction Layer (docs/10_GLOBAL_JURISDICTION_LAYER.md).
-- Xalqaro ilmiy dalil (claims, knowledge_layer = international_scientific)
-- va davlat qonuni/protsedurasi bir-biriga aralashtirilmaydi.
-- Bu jadvallar hozircha BO‘SH: real qonunlar yig‘ilmagan.
-- ---------------------------------------------------------------------------

CREATE TABLE jurisdictions (
  jurisdiction_id TEXT NOT NULL PRIMARY KEY,   -- INT, EU, UZ, US, US-CA
  level TEXT NOT NULL CHECK (level IN ('international','supranational','country','subdivision')),
  parent_id TEXT REFERENCES jurisdictions (jurisdiction_id),
  iso3166 TEXT,
  names_json TEXT NOT NULL DEFAULT '{}'
) WITHOUT ROWID;

CREATE TABLE authorities (
  authority_id TEXT NOT NULL PRIMARY KEY,
  jurisdiction_id TEXT NOT NULL REFERENCES jurisdictions (jurisdiction_id),
  names_json TEXT NOT NULL DEFAULT '{}'
) WITHOUT ROWID;

CREATE TABLE jurisdictional_instruments (
  instrument_id TEXT NOT NULL PRIMARY KEY,
  jurisdiction_id TEXT NOT NULL REFERENCES jurisdictions (jurisdiction_id),
  instrument_type TEXT NOT NULL CHECK (instrument_type IN ('law','regulation','controlled_substance_schedule','standard','national_method','official_guideline','international_convention')),
  titles_json TEXT NOT NULL DEFAULT '{}',
  official_source_id TEXT NOT NULL REFERENCES sources (source_id),
  official_reference TEXT,
  effective_from TEXT NOT NULL,
  effective_to TEXT,
  version TEXT NOT NULL CHECK (length(version) > 0),
  last_verified_at TEXT,
  review_status TEXT NOT NULL CHECK (review_status IN ('DRAFT','VERIFIED','REVIEWED','NEEDS_REVIEW','OUTDATED','REJECTED')),
  is_test_data INTEGER NOT NULL DEFAULT 0,
  authority_id TEXT REFERENCES authorities (authority_id),
  publication_date TEXT,
  last_amended_at TEXT,
  legal_status TEXT NOT NULL DEFAULT 'in_force' CHECK (legal_status IN ('in_force','amended','superseded','repealed')),
  language TEXT,
  translation_status TEXT CHECK (translation_status IS NULL OR translation_status IN ('machine_draft','translated','reviewed')),
  CHECK (effective_to IS NULL OR effective_to > effective_from)
) WITHOUT ROWID;

CREATE INDEX instruments_by_jurisdiction ON jurisdictional_instruments (jurisdiction_id);

CREATE TABLE jurisdictional_rules (
  rule_id TEXT NOT NULL PRIMARY KEY,
  instrument_id TEXT NOT NULL REFERENCES jurisdictional_instruments (instrument_id),
  rule_type TEXT NOT NULL CHECK (rule_type IN ('control_status','procedure_requirement','legal_threshold')),
  subject_type TEXT NOT NULL,
  subject_id TEXT NOT NULL,
  value_json TEXT NOT NULL,
  effective_from TEXT NOT NULL,
  effective_to TEXT,
  review_status TEXT NOT NULL CHECK (review_status IN ('DRAFT','VERIFIED','REVIEWED','NEEDS_REVIEW','OUTDATED','REJECTED')),
  is_test_data INTEGER NOT NULL DEFAULT 0,
  article_section TEXT,
  topic_key TEXT,
  applies_to_json TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  CHECK (effective_to IS NULL OR effective_to > effective_from)
) WITHOUT ROWID;

CREATE INDEX rules_by_subject ON jurisdictional_rules (subject_type, subject_id);

-- ---------------------------------------------------------------------------
-- PHASE 4: Global bilim sohalari — yagona, kengayadigan yozuv jadvali.
-- Mazmun (ta’rif, cheklov, iqtibos) claims jadvalida, manba bilan.
-- payload_json — tiplangan yozuv (ScreeningTest, SolutionRecipe, MethodRecord,
-- EmergingIssue) pipeline validatoridan o‘tgan holatda.
-- ---------------------------------------------------------------------------

CREATE TABLE knowledge_entities (
  entity_id TEXT NOT NULL PRIMARY KEY,
  entity_type TEXT NOT NULL CHECK (entity_type IN ('topic','reagent','screening_test','method','emerging_issue')),
  area TEXT NOT NULL,
  subtype TEXT,
  names_json TEXT NOT NULL,
  tier_access TEXT NOT NULL CHECK (tier_access IN ('free','student','pro')),
  review_status TEXT NOT NULL CHECK (review_status IN ('DRAFT','VERIFIED','REVIEWED','NEEDS_REVIEW','OUTDATED','REJECTED')),
  version INTEGER NOT NULL DEFAULT 1,
  jurisdiction_id TEXT REFERENCES jurisdictions (jurisdiction_id),
  organization TEXT,
  event_date TEXT,
  payload_json TEXT NOT NULL DEFAULT '{}',
  content_version TEXT NOT NULL,
  is_test_data INTEGER NOT NULL DEFAULT 0
) WITHOUT ROWID;

CREATE INDEX knowledge_by_type ON knowledge_entities (entity_type, area);

CREATE TABLE entity_sources (
  entity_id TEXT NOT NULL REFERENCES knowledge_entities (entity_id),
  source_id TEXT NOT NULL REFERENCES sources (source_id),
  locator TEXT,
  PRIMARY KEY (entity_id, source_id)
) WITHOUT ROWID;

CREATE TABLE claim_groups (
  group_id TEXT NOT NULL PRIMARY KEY,
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  field TEXT NOT NULL,
  context_key TEXT NOT NULL,
  conflict_state TEXT NOT NULL CHECK (conflict_state IN ('consistent','minor_difference','conflict','unresolved')),
  editorial_note TEXT,
  display_policy TEXT NOT NULL DEFAULT 'show_all'
) WITHOUT ROWID;

CREATE TABLE claims (
  claim_id TEXT NOT NULL PRIMARY KEY,
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  field TEXT NOT NULL,
  value_json TEXT NOT NULL,
  domain TEXT NOT NULL CHECK (domain IN ('tox','fm','lab','legal','edu','i18n')),
  review_status TEXT NOT NULL CHECK (review_status IN ('DRAFT','VERIFIED','REVIEWED','NEEDS_REVIEW','OUTDATED','REJECTED')),
  evidence_level TEXT NOT NULL,
  group_id TEXT REFERENCES claim_groups (group_id),
  preferred INTEGER NOT NULL DEFAULT 0,
  preference_reason TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  updated_at TEXT NOT NULL,
  is_test_data INTEGER NOT NULL DEFAULT 0,
  -- Global Scientific Core + Jurisdiction Layer (schema_version = 2).
  knowledge_layer TEXT NOT NULL DEFAULT 'international_scientific'
    CHECK (knowledge_layer IN ('international_scientific','international_standard','jurisdictional')),
  jurisdiction_id TEXT REFERENCES jurisdictions (jurisdiction_id),
  instrument_id TEXT REFERENCES jurisdictional_instruments (instrument_id),
  CHECK (preferred = 0 OR preference_reason IS NOT NULL),
  -- Qatlamlar aralashmaydi: faqat yurisdiksion claim davlatga bog‘lanadi.
  CHECK (
    (knowledge_layer = 'jurisdictional' AND jurisdiction_id IS NOT NULL AND instrument_id IS NOT NULL)
    OR (knowledge_layer <> 'jurisdictional' AND jurisdiction_id IS NULL AND instrument_id IS NULL)
  )
) WITHOUT ROWID;

CREATE INDEX claims_by_entity ON claims (entity_type, entity_id, field);

CREATE TABLE citations (
  claim_id TEXT NOT NULL REFERENCES claims (claim_id),
  source_id TEXT NOT NULL REFERENCES sources (source_id),
  locator TEXT,
  PRIMARY KEY (claim_id, source_id)
) WITHOUT ROWID;

CREATE TABLE reviewers (
  reviewer_id TEXT NOT NULL PRIMARY KEY,
  display_name TEXT NOT NULL,
  qualification TEXT,
  active INTEGER NOT NULL DEFAULT 1
) WITHOUT ROWID;

CREATE TABLE reviewer_domains (
  reviewer_id TEXT NOT NULL REFERENCES reviewers (reviewer_id),
  domain TEXT NOT NULL,
  can_verify INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (reviewer_id, domain)
) WITHOUT ROWID;

CREATE TABLE reviews (
  review_id TEXT NOT NULL PRIMARY KEY,
  target_type TEXT NOT NULL,
  target_id TEXT NOT NULL,
  target_version INTEGER NOT NULL,
  domain TEXT NOT NULL,
  reviewer_id TEXT NOT NULL REFERENCES reviewers (reviewer_id),
  decision TEXT NOT NULL CHECK (decision IN ('approve','request_changes','reject')),
  created_at TEXT NOT NULL
) WITHOUT ROWID;

CREATE TABLE substances (
  substance_id TEXT NOT NULL PRIMARY KEY,
  canonical_name TEXT NOT NULL UNIQUE,
  entity_kind TEXT NOT NULL,
  molecular_formula TEXT,
  tier_access TEXT NOT NULL CHECK (tier_access IN ('free','student','pro')),
  review_status TEXT NOT NULL,
  last_reviewed_at TEXT,
  content_version TEXT NOT NULL,
  is_test_data INTEGER NOT NULL DEFAULT 0,
  -- PHASE 5: tahririy guruh (navigatsiya uchun; ilmiy claim emas).
  substance_group TEXT
) WITHOUT ROWID;

CREATE TABLE substance_i18n (
  substance_id TEXT NOT NULL REFERENCES substances (substance_id),
  lang TEXT NOT NULL,
  name TEXT NOT NULL,
  description_md TEXT,
  translation_status TEXT NOT NULL CHECK (translation_status IN ('machine_draft','translated','reviewed')),
  PRIMARY KEY (substance_id, lang)
) WITHOUT ROWID;

-- Tashqi identifikatorlar: pubchem_cid, inchikey, chebi, drugbank_open, cas_rn...
-- Qaysi biri saqlanadi/ko‘rsatiladi/qidiriladi — IdentifierPolicy hal qiladi.
CREATE TABLE external_identifiers (
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  scheme TEXT NOT NULL,
  identifier_value TEXT NOT NULL,
  source_id TEXT NOT NULL REFERENCES sources (source_id),
  PRIMARY KEY (entity_type, entity_id, scheme, identifier_value)
) WITHOUT ROWID;

CREATE TABLE concentration_records (
  record_id TEXT NOT NULL PRIMARY KEY,
  substance_id TEXT NOT NULL REFERENCES substances (substance_id),
  category TEXT NOT NULL CHECK (category IN ('therapeutic_reference','toxic_reference','reported_postmortem','reported_impairment')),
  specimen_code TEXT NOT NULL,
  population TEXT NOT NULL,
  value_type TEXT NOT NULL,
  value_low REAL,
  value_high REAL,
  value_central REAL,
  unit TEXT NOT NULL,
  n_cases INTEGER,
  claim_id TEXT NOT NULL REFERENCES claims (claim_id),
  is_test_data INTEGER NOT NULL DEFAULT 0
) WITHOUT ROWID;

-- Global Search terminlari. search_key — fe_search_core SearchNormalizer.searchKey().
CREATE TABLE search_terms (
  term_id INTEGER NOT NULL PRIMARY KEY,
  entity_type TEXT NOT NULL,
  entity_id TEXT NOT NULL,
  category TEXT NOT NULL,
  lang TEXT,
  term TEXT NOT NULL,
  search_key TEXT NOT NULL,
  term_kind TEXT NOT NULL,
  weight REAL NOT NULL DEFAULT 1.0
) AS SearchTermRow;

CREATE INDEX search_terms_key ON search_terms (search_key);

-- Typo-tolerant qidiruv: trigram tokenizer (SQLite >= 3.34).
CREATE VIRTUAL TABLE search_fts_tri USING fts5(
  search_key,
  content='search_terms',
  content_rowid='term_id',
  tokenize='trigram'
);

-- ---------------------------------------------------------------------------
-- PHASE 5 (schema_version = 4): Research / Evidence Library, bilim grafigi,
-- ilmiy rasmlar. To‘liq matn saqlanmaydi — faqat metadata va havola.
-- ---------------------------------------------------------------------------

CREATE TABLE research_records (
  research_id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('journal_article','review','systematic_review','meta_analysis','case_report','conference_abstract','conference_paper','dissertation','thesis','official_report','standard','guideline','validation_study','case_series')),
  title TEXT NOT NULL,
  authors_json TEXT NOT NULL DEFAULT '[]',
  organization TEXT,
  container TEXT,
  pub_year TEXT,
  doi TEXT,
  pmid TEXT,
  pmcid TEXT,
  handle TEXT,
  url TEXT,
  degree TEXT,
  open_access TEXT,
  source_api TEXT,
  accessed_date TEXT,
  evidence_level TEXT NOT NULL,
  peer_reviewed INTEGER NOT NULL,
  review_status TEXT NOT NULL CHECK (review_status IN ('DRAFT','VERIFIED','REVIEWED','NEEDS_REVIEW','OUTDATED','REJECTED')),
  is_test_data INTEGER NOT NULL DEFAULT 0,
  -- PHASE 6: forensik dolzarblik dalil sifatidan alohida (reviewer belgilaydi).
  forensic_relevance TEXT NOT NULL DEFAULT 'unassessed' CHECK (forensic_relevance IN ('unassessed','direct','supporting','background')),
  language TEXT,
  CHECK (doi IS NOT NULL OR pmid IS NOT NULL OR handle IS NOT NULL OR url IS NOT NULL)
) WITHOUT ROWID;

CREATE INDEX research_by_kind ON research_records (kind);

CREATE TABLE entity_links (
  from_id TEXT NOT NULL,
  to_id TEXT NOT NULL,
  relation TEXT NOT NULL CHECK (relation IN ('analysed_by','metabolism_co_mention','confirmed_by','used_in','research','related_topic')),
  basis TEXT NOT NULL CHECK (length(basis) > 0),
  PRIMARY KEY (from_id, to_id, relation)
) WITHOUT ROWID;

CREATE INDEX links_by_to ON entity_links (to_id);

CREATE TABLE images (
  image_id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('chemical_structure','schematic','chromatogram','mass_spectrum','micrograph','tlc_plate','colour_test','photo')),
  entity_id TEXT NOT NULL,
  mime_type TEXT NOT NULL,
  bytes BLOB NOT NULL,
  width INTEGER,
  height INTEGER,
  sha256 TEXT NOT NULL,
  title_json TEXT NOT NULL,
  alt_json TEXT NOT NULL,
  caption_original TEXT,
  creator TEXT,
  source_name TEXT,
  source_url TEXT,
  doi TEXT,
  license TEXT NOT NULL,
  attribution TEXT NOT NULL CHECK (length(attribution) > 0),
  is_original_diagram INTEGER NOT NULL,
  represents_real_data INTEGER NOT NULL,
  graphic INTEGER NOT NULL DEFAULT 0 CHECK (graphic = 0),
  accessed_date TEXT,
  CHECK (NOT (is_original_diagram = 1 AND represents_real_data = 1))
);

CREATE INDEX images_by_entity ON images (entity_id);
