{
 "topic": "Xromatek «Kristallyuks» gaz xromatografida etanolni aniqlash",
 "slides": [
  {
   "title": "Reja va tayanch so‘zlar",
   "bullets": [
    {
     "text": "Reja: etanol toksikologiyasi, GX qurilmasi, tayyorlash, namuna, o‘lchash, hisoblash, tozalash.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
     },
     "uncertain": false
    },
    {
     "text": "Maqsad: spirtlarni qon va peshobdan GSX usulida sifat va miqdor jihatdan aniqlash.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
     },
     "uncertain": false
    },
    {
     "text": "Tayanch so‘zlar: dozator, kolonka, termostat, detektor, ushlanish vaqti, alkilnitrit, ichki standart.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "191"
     },
     "uncertain": false
    }
   ],
