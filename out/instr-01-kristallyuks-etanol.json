  {
   "title": "GSX nima: ikki guruh",
   "bullets": [
    {
     "text": "Gaz xromatografiyasi gaz-adsorbsion va gaz-suyuqlik (GSX) xromatografiyasiga bo‘linadi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
     },
     "uncertain": false
    },
    {
     "text": "Gaz-suyuqlik usulida qo‘zg‘almas faza g‘ovak qattiq modda ustiga qoplangan suyuqlikdir.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
     },
     "uncertain": false
    },
    {
     "text": "Ikkala usulda ham qo‘zg‘aluvchi faza gaz hisoblanadi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
