  },
  {
   "title": "Nega etanol GSX usulida aniqlanadi",
   "bullets": [
    {
     "text": "Etil spirti farmakologik ta’siri bo‘yicha narkotik moddalar guruhiga kiradi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "41"
     },
     "uncertain": false
    },
    {
     "text": "Ichilganda qonga tez o‘tadi; 5 daqiqadan keyin qondan aniqlash mumkin.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "41"
     },
     "uncertain": false
    },
    {
     "text": "Jigarda tez oksidlanadi (90–99 % CO2 gacha), shu sababli tahlil tezlik bilan olib boriladi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "41"
     },
     "uncertain": false
    }
   ],
   "diagram": {
    "kind": "facts",
    "items": [
     {
      "label": "Qonda topiladi",
      "value": "5",
      "unit": "daqiqadan"
     },
     {
      "label": "CO2 gacha oksidlanadi",
      "value": "90–99",
      "unit": "%"
     },
     {
      "label": "Qaynash harorati",
      "value": "77–78,5",
      "unit": "°C"
     }
    ],
    "caption": "Etanol: kitobdagi ko‘rsatkichlar"
   },
   "teacher_notes": "Kitobdagi «0,2‰ o‘limga olib keladi» yozuvi xato deb belgilangan (docs/toks/kitob_ziddiyatlari.md) — slaydga kiritilmadi."
  },
  {
   "title": "Etanol organizmda: yo‘l",
   "bullets": [
    {
     "text": "Spirt qonga tez o‘tadi, jigarda oksidlanadi; qolgani nafas va buyrak orqali chiqadi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "41"
     },
     "uncertain": false
    },
    {
     "text": "Zaharlanganda spirtning peshobdagi konsentratsiyasi qondagidan ancha ko‘p bo‘ladi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "41"
     },
     "uncertain": false
    },
    {
     "text": "Tahlil uchun me’da, jigar, buyrak va miya olinishi mumkin.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "41"
     },
     "uncertain": false
    }
   ],
