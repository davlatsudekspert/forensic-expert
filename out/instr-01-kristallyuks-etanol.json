  {
   "title": "Ajralish mohiyati",
   "bullets": [
    {
     "text": "Aralashma isitilgan gaz oqimiga yuboriladi; suyuqlik termostatda yuqori haroratda gazga aylanadi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
     },
     "uncertain": false
    },
    {
     "text": "Kolonkada moddalar qo‘zg‘almas va gaz fazalari orasida bir necha bor adsorbsiya va desorbsiyaga uchraydi.",
     "source": {
      "author": "Yuldashev Z.O., Umarova G.Q.",
      "title": "Toksikologik kimyo (o‘quv-uslubiy majmua), 2025",
      "page": "188"
     },
     "uncertain": false
    },
    {
     "text": "Ajralish samaradorligi moddalarning taqsimlanish koeffitsiyentiga bog‘liq.",
     "source": {
